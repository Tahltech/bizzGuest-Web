# ──────────────────────────────────────────────────────────────────
# BizzGuest — environment configuration
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file.
# ──────────────────────────────────────────────────────────────────

# ---- General ----
NODE_ENV=development
APP_NAME=BizzGuest
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
TZ=Africa/Douala
DEFAULT_CURRENCY=XAF

# ---- Ports (host side) ----
FRONTEND_PORT=5173
BACKEND_PORT=4000
DB_PORT=3306

# ---- Database (MariaDB) ----
DB_HOST=db
DB_PORT_INTERNAL=3306
DB_NAME=bizzguest
DB_USER=bizzguest_app
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHAR_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Field-level encryption (guest ID numbers, etc.) ----
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ══════════════════════════════════════════════════════════════════
# PAYMENTS — Campay (MTN Mobile Money + Orange Money aggregator)
# ══════════════════════════════════════════════════════════════════
# >>> REQUIRES YOUR API KEYS <<<
# Get these from your Campay dashboard: https://www.campay.net
#   1. Create/select an app in the Campay dashboard
#   2. Copy the "App Username" and "App Password" (permanent token credentials)
#   3. Set CAMPAY_ENV=live only when you are ready to accept real payments
#   4. CAMPAY_WEBHOOK_KEY: the webhook signing key shown in the app's
#      webhook settings — used to verify that /api/v1/payments/webhook/campay
#      requests genuinely come from Campay.
CAMPAY_ENV=sandbox
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_USERNAME=REPLACE_WITH_CAMPAY_APP_USERNAME
CAMPAY_APP_PASSWORD=REPLACE_WITH_CAMPAY_APP_PASSWORD
CAMPAY_WEBHOOK_KEY=REPLACE_WITH_CAMPAY_WEBHOOK_KEY

# ══════════════════════════════════════════════════════════════════
# EMAIL — SMTP (swap provider later without touching business logic)
# ══════════════════════════════════════════════════════════════════
# >>> REQUIRES YOUR SMTP CREDENTIALS <<<
# Any SMTP provider works (Gmail app password, Brevo, Mailgun, SES SMTP, etc.)
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_NAME=BizzGuest
MAIL_FROM_ADDRESS=no-reply@bizzguest.example

# ---- Media storage ----
# STORAGE_DRIVER=local for now; the adapter interface supports s3/r2/cloudinary later
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173
